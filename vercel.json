{
  "version": 2,
  "builds": [
    {
      "src": "./index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/",
      "methods":["GET","POST","DELETE","PUT","PATCH","OPTIONS"]
    }
  ],
  "crons": [
    {
      "path": "/cron/sync-google-sheet",
      "schedule": "0 18 * * *"
    }
  ]
}